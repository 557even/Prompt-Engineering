        "output_format": ["plain_text", "json", "both"],
        "domain_context": ["receipt", "textbook", "manga", "code", "form", "id", "table", "handwriting"],
        "priority_modes": {
          "recall_vs_precision": ["high_recall", "balanced", "high_precision"],
          "layout_mode": ["preserve_layout", "reading_order", "strict_columns"]
        }
      }
    },

    "processing_pipeline": {
      "layer_0_page_intake": {
        "description": "Page analysis and strategy planning",
        "detection_tasks": [
          "document_type_cues",
          "quality_issues_assessment",
          "layout_complexity"
        ],
        "strategy_knobs": {
          "recall_vs_precision": "balanced",
          "layout_mode": "preserve_layout",
          "confidence_threshold": 0.5
        },
        "output": "page_plan_with_preprocessing_actions"
      },

      "layer_1_global_normalization": {
        "description": "Page-wide image enhancement",
        "optional_actions": [
          "orientation_correction",
          "deskew_perspective_correction",
          "contrast_brightness_normalization",
          "denoising_adaptive",
          "deblurring_conservative",
          "color_handling_intelligent"
        ],
        "selection_criteria": "apply_only_as_needed_per_page"
      },

      "layer_2_structure_segmentation": {
        "description": "Document structure analysis",
        "region_types": [
          "headers",
          "footers",
          "main_body",
          "sidebars",
          "captions",
          "page_numbers",
          "stamps_watermarks",
          "tables",
          "forms",
          "code_blocks"
        ],
        "output": "region_list_in_reading_order"
      },

      "layer_3_region_specific_processing": {
        "description": "Targeted enhancement per region type",
        "region_handlers": {
          "paragraph_text": "preserve_hyphenation_line_separation",
          "table_cells": "maintain_cell_boundaries",
          "forms": "enhance_handwriting_isolate_fields",
          "code_blocks": "preserve_indentation_glyph_fidelity",
          "math_equations": "keep_symbols_alignment",
          "watermarks": "extract_separately"
        }
      },

      "layer_4_character_extraction": {
        "description": "Fine-grained text extraction",
        "preservation_rules": [
          "original_spacing_line_breaks",
          "disambiguate_confusables",
          "exact_character_reproduction"
        ],
        "uncertainty_handling": {
          "unclear_characters": "⟦UNCLEAR⟧ marker",
          "unreadable_regions": "⟦UNREADABLE_REGION⟧ with reason"
        }
      },

      "layer_5_reconstruction_consistency": {
        "description": "Final output assembly and validation",
        "verification_checks": [
          "header_footer_consistency",
          "table_structure_integrity",
          "code_formatting_preservation",
          "layout_fidelity"
        ]
      }
    },

    "output_specification": {
