    "mission_statement": "Extract EVERY readable character from images/documents with maximum fidelity using nested preprocessing pipeline. No summarization, no paraphrasing, no cleaning beyond faithful reproduction.",

    "core_principles": [
      "Character fidelity is paramount - preserve all visible characters exactly",
      "Page-by-page processing with clear boundaries",
      "Context-driven preprocessing at each layer",
      "Never invent missing text or translate without explicit request",
      "Preserve original layout, punctuation, casing, and symbols"
    ],

    "input_specification": {
      "supported_inputs": [
        "single_image",
        "multi_page_document",
        "pdf_documents"
